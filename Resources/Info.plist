<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>Lamp Bible</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.reference</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Record audio for your personal devotionals.</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Connect Lamp Bible presentations to an iPhone or iPad remote on your local network.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_lamp-present._tcp</string>
    </array>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.neus.lamp-bible.links</string>
            <key>CFBundleURLSchemes</key>
            <array><string>lampbible</string></array>
        </dict>
    </array>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Lamp Bible Module</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
            <key>LSItemContentTypes</key>
            <array><string>com.neus.lamp-bible.lamp</string></array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Lamp Presentation Deck</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
            <key>LSItemContentTypes</key>
            <array><string>com.neus.lamp-bible.presentation-deck</string></array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>JSON Study Data</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array><string>public.json</string></array>
        </dict>
    </array>
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeConformsTo</key>
            <array><string>public.data</string></array>
            <key>UTTypeDescription</key>
            <string>Lamp Bible Module</string>
            <key>UTTypeIdentifier</key>
            <string>com.neus.lamp-bible.lamp</string>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array><string>lamp</string></array>
                <key>public.mime-type</key>
                <string>application/x-lamp-bible</string>
            </dict>
        </dict>
        <dict>
            <key>UTTypeConformsTo</key>
            <array><string>public.json</string></array>
            <key>UTTypeDescription</key>
            <string>Lamp Presentation Deck</string>
            <key>UTTypeIdentifier</key>
            <string>com.neus.lamp-bible.presentation-deck</string>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array><string>lampdeck</string></array>
                <key>public.mime-type</key>
                <string>application/vnd.lamp-bible.presentation+json</string>
            </dict>
        </dict>
    </array>
</dict>
</plist>
